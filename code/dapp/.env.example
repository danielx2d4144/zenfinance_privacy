# dapp config. Copy to .env.local (gitignored) and fill in real values.
#
# Two profiles matter:
#   local Anvil  — NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337
#   Horizen demo — NEXT_PUBLIC_DEFAULT_CHAIN_ID=2651420
# Both address sets can be present at once; the chain id selects between them
# (see src/lib/chain-config.ts).

NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337
NEXT_PUBLIC_ANVIL_RPC=http://127.0.0.1:8545

# Optional override. Defaults to https://horizen-testnet.rpc.caldera.xyz,
# which answers eth_chainId 0x28751c (2651420).
NEXT_PUBLIC_HORIZEN_TESTNET_RPC=

# WalletConnect v2 project ID. Get one at https://cloud.walletconnect.com.
NEXT_PUBLIC_WC_PROJECT_ID=

# Data-API base URL (the Day-11 / Day-12 service).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_API_KEY=

# Subgraph endpoint (the Day-10 graph-node stack on Anvil). Not used by the
# dapp's balance views on purpose — indexer queries would leak commitments.
NEXT_PUBLIC_SUBGRAPH_URL=http://127.0.0.1:8000/subgraphs/name/lending/anvil

# ---- local Anvil ------------------------------------------------------------
# Mirrors code/backend/subgraph/anvil-addrs.json. These shift whenever the
# deploy script changes nonce order, so re-copy them after re-running
# EmitTestEvents.s.sol rather than trusting the values below.
NEXT_PUBLIC_ANVIL_PRIVACY_ENTRY=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
NEXT_PUBLIC_ANVIL_MOCK_USDC=0xcf7ed3acca5a467e9e704c703e8d87f634fb0fc9
NEXT_PUBLIC_ANVIL_ORACLE=0x0165878A594ca255338adfa4d48449f69242Eb8F
NEXT_PUBLIC_ANVIL_RATE_MODEL=0x959922bE3CAee4b8Cd9a407cc3ac1C251C2007B1
NEXT_PUBLIC_ANVIL_ASSET_REGISTRY=0xA51c1fc2f0D1a1b8494Ed1FE312d7C3a78Ed91C0
NEXT_PUBLIC_ANVIL_SHIELDED_SUPPLY_POOL=0x59b670e9fA9D0A427751Af201D676719a970857b
NEXT_PUBLIC_ANVIL_SHIELDED_POSITION_POOL=0x4ed7c70F96B99c776995fB64377f0d4aB3B0e1C1

# ---- Horizen testnet (2651420) — the M3 demo target -------------------------
# From code/contracts/deployments/horizen-testnet-2651420.json. All 11
# contracts are verified on horizen-testnet.explorer.caldera.xyz.
NEXT_PUBLIC_HORIZEN_PRIVACY_ENTRY=0xaFf6608e440799c669145997fC230d51404A5142
NEXT_PUBLIC_HORIZEN_MOCK_USDC=0xebb4B50494BFa79FF0B33ea927000aC48b0C2Fa1
NEXT_PUBLIC_HORIZEN_ORACLE=0x852da28C9Bc35870eB01e2D49296b8c1E3204024
NEXT_PUBLIC_HORIZEN_RATE_MODEL=0x32Db36d6FeDf7a1D4D0317C0AaD3b08B03eB8297
NEXT_PUBLIC_HORIZEN_ASSET_REGISTRY=0x0D6097E8E5804Cd540D317B9A633AAB925d782A6
NEXT_PUBLIC_HORIZEN_SHIELDED_SUPPLY_POOL=0x43c5Ba0B57b5fb99B09f34De89825335D82681f1
NEXT_PUBLIC_HORIZEN_SHIELDED_POSITION_POOL=0x2433D5ef60b0444A2830636e754417eA76C7FE87

# zkVerify aggregation proxy. Defaults to this value in chain-config.ts; set it
# here only to override.
NEXT_PUBLIC_HORIZEN_ZKVERIFY_PROXY=0x3098A6974649478f0133046e44105AA84e868C21

# M2 note-recovery scan floor. Wrong value = recovery either misses notes or
# scans from genesis (24M+ blocks on this chain).
NEXT_PUBLIC_HORIZEN_DEPLOY_BLOCK=24177251

# Admin panel gate. /admin is prerendered as PUBLIC static content and exposes
# Oracle/RateModel privileged calls. On-chain DEFAULT_ADMIN_ROLE is the real
# security boundary (a stranger's tx reverts), but the page should not ship on
# a public deployment. Set to "true" only locally or in a private preview.
# NEXT_PUBLIC_ENABLE_ADMIN=true
