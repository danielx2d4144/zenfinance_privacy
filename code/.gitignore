# Secrets and local-only files. Per code_standard.md sec.7.
.env
.env.local
*.key
*.pem

# Build outputs
node_modules/
dist/
build/
out/
cache/
target/

# ...except the compiled circuit artifacts, which are the one build output we
# genuinely have to ship. Vercel builds the dapp from this repo and has no Noir
# toolchain, so scripts/copy-circuit-artifacts.mjs would find nothing and we
# would deploy a dapp that cannot prove anything. 1.3 MB for all 11 circuits.
#
# `target/` above ignores the directory, and git does not descend into an
# ignored directory, so the directory has to be re-included before any file in
# it can be. Then re-ignore the contents and name only what we want — the rest
# of target/ is ~100 KB of Verifier.sol per circuit plus raw proof/vk blobs.
#
# The `*/` prefix is deliberately one level deep: it covers the 11 real
# circuits and leaves circuits/scripts/*/target (throwaway helper crates)
# ignored.
!circuits/*/target/
circuits/*/target/*
!circuits/*/target/*.json
!circuits/*/target/kurier_vk_hash

# Foundry / Hardhat / TS noise
*.tsbuildinfo
lcov.info

# OS
.DS_Store
Thumbs.db
