# Day-9 price-keeper config. Copy to .env (gitignored) and fill in real values.

# Base Sepolia RPC + signer
BASE_SEPOLIA_HTTPS=https://sepolia.base.org
RELAYER_PRIVATE_KEY=<paste-fresh-private-key-here>

# Contracts on Base Sepolia
ORACLE_BASE_SEPOLIA=<oracle-address-from-DeployOracle>
STORK_BASE_SEPOLIA=0x647DFd812BC1e116c6992CB2bC353b2112176fD6

# Stork REST API. Get a token by emailing sales@stork.network — required to
# fetch signed price updates. The "jp" host is the production REST; the "dev"
# host is for development/testnet keys.
STORK_REST_URL=https://rest.jp.stork-oracle.network
STORK_API_TOKEN=<paste-stork-basic-auth-token>

# Feeds to push every cadence. Comma-separated asset symbols.
STORK_FEEDS=BTCUSD

# Cadence + behavior knobs.
PUSH_INTERVAL_SECONDS=30
PRICE_MOVE_THRESHOLD_BPS=50  # 0.5%

# accrue-keeper target. Set after DeployLendingStack runs.
RATE_MODEL_BASE_SEPOLIA=<rate-model-address>
ACCRUE_ASSETS=0,1
ACCRUE_INTERVAL_SECONDS=300  # 5 min

# ---- M3: Horizen testnet keeper ---------------------------------------------
# A separate config block (src/horizen-config.ts) because none of the Stork
# variables above apply: Horizen's Oracle was deployed with stork_ = address(0),
# so prices arrive via Oracle.pushPrice under MANAGER_ROLE. There is no Stork
# contract, no signed payload and no API token on this chain.
#
#   npm run horizen:push-once   # one sweep, exits — Railway cron shape
#   npm run horizen:keep        # long-running loop — local demo shape
#
# THIS IS NOT OPTIONAL for the demo. Oracle.MAX_STALENESS_WINDOW is 3600s, and
# getPrice reverts past it — which takes every borrow, collateral and
# liquidation flow down with it.

HORIZEN_TESTNET_HTTPS=https://horizen-testnet.rpc.caldera.xyz/http
HORIZEN_TESTNET_CHAIN_ID=2651420
ORACLE_HORIZEN=0x852da28C9Bc35870eB01e2D49296b8c1E3204024

# Signs pushPrice. Use the RELAYER key above, NOT the deployer: the deployer
# also holds DEFAULT_ADMIN_ROLE and lives outside the repo on purpose. The
# relayer was granted MANAGER_ROLE on 2026-08-03 so this process needs nothing
# more than what it already has.

# 0 = tUSDC (pinned to $1, no feed lookup), 1 = tcbBTC.
HORIZEN_ASSET_IDS=0,1

# Push at a fraction of the 3600s window so one failed run is not an outage.
HORIZEN_PUSH_INTERVAL_SECONDS=900
HORIZEN_MAX_AGE_SECONDS=1800

# Spot source for tcbBTC. No API key, because this runs unattended. If it is
# unreachable the keeper re-pushes the last on-chain value rather than skipping
# the round — freshness matters more than accuracy on a testnet.
BTC_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd
BTC_PRICE_TIMEOUT_MS=10000
