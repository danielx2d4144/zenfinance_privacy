# data-api config. Copy to .env (gitignored) and fill in real values.
#
# Two profiles matter:
#   local Anvil  — ATTESTATION_MODE=mock, CHAIN_ID=31337
#   Horizen demo — ATTESTATION_MODE=kurier, CHAIN_ID=2651420
# The commented block at the bottom lists the Horizen overrides.

# Server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (the docker-compose stack from code/infra/data-stack exposes 5432)
DATABASE_URL=postgres://graph:graph@localhost:5432/graphnode

# X-API-Key value clients must send to use action endpoints.
# Any non-empty string >= 16 chars; tests inject their own.
API_KEY=dev-api-key-please-rotate-before-prod

# ---- destination chain (Anvil fixture, re-uses the Day-10 docker stack) ----
# Named CHAIN_* since M3; these were ANVIL_* when Anvil was the only target.
CHAIN_HTTPS=http://localhost:8545
CHAIN_ID=31337
# First Anvil account.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Set after running code/contracts/script/EmitTestEvents.s.sol.
# Mirror the values in code/backend/subgraph/anvil-addrs.json.
PRIVACY_ENTRY_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
MOCK_USDC_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
SHIELDED_SUPPLY_POOL_ADDRESS=0x59b670e9fA9D0A427751Af201D676719a970857b
SHIELDED_POSITION_POOL_ADDRESS=0x4ed7c70F96B99c776995fB64377f0d4aB3B0e1C1
LIQUIDATION_BOARD_ADDRESS=0x322813Fd9A801c5507c9de605d63CEA4f2CE6c44
ZK_VERIFIER_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# ---- attestation -----------------------------------------------------------
# mock   = synthetic receipt + MockVerifyProofAggregation.setAllowed.
#          NO CRYPTOGRAPHY IS CHECKED. Anvil only, because no real zkVerify
#          aggregation domain targets chain 31337.
# kurier = the real path: Kurier -> zkVerify -> destination-chain proxy.
ATTESTATION_MODE=mock
MOCK_PROXY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# zkVerify on-chain aggregation domain. Domains are per-destination-chain
# containers: Base Sepolia = 2, Horizen testnet = 175 (proven on-chain
# 2026-08-03; see GROUND_TRUTH.md).
ZK_DOMAIN_ID=2

# ---- Kurier (only read when ATTESTATION_MODE=kurier) -----------------------
KURIER_BASE_URL=https://relayer-api-testnet.horizenlabs.io/api/v1
# Same key as code/backend/prover-service/.env. Required in kurier mode.
KURIER_API_KEY=
KURIER_POLL_INTERVAL_MS=5000
# Measured time-to-Aggregated on Horizen testnet: 2m 54s. 20 min is ~7x
# headroom; past that a job is stuck rather than slow.
KURIER_POLL_TIMEOUT_MS=1200000

# ---- Horizen testnet overrides ---------------------------------------------
# Deployed 2026-08-03 at block 24177251; all 11 contracts verified on
# horizen-testnet.explorer.caldera.xyz. Source of truth for these addresses is
# code/contracts/deployments/horizen-testnet-2651420.json.
#
# Keep these as a separate `.env.horizen` rather than editing `.env` in place —
# dotenv does not override variables already in the environment, so
# `set -a; source .env.horizen; set +a; npm start` wins and the Anvil profile
# survives for the local dev loop.
#
# CHAIN_HTTPS=https://horizen-testnet.rpc.caldera.xyz/http
# CHAIN_ID=2651420
# ATTESTATION_MODE=kurier
# RELAYER_PRIVATE_KEY=<the funded relayer, shared with prover-service>
# KURIER_API_KEY=<required in kurier mode>
# MOCK_PROXY_ADDRESS=
# ZK_DOMAIN_ID=175
# PRIVACY_ENTRY_ADDRESS=0xaFf6608e440799c669145997fC230d51404A5142
# MOCK_USDC_ADDRESS=0xebb4B50494BFa79FF0B33ea927000aC48b0C2Fa1
# SHIELDED_SUPPLY_POOL_ADDRESS=0x43c5Ba0B57b5fb99B09f34De89825335D82681f1
# SHIELDED_POSITION_POOL_ADDRESS=0x2433D5ef60b0444A2830636e754417eA76C7FE87
# LIQUIDATION_BOARD_ADDRESS=0xBB58b1457f6c486873FC85c42ED1380df475eff2
# ZK_VERIFIER_ADDRESS=0xb30323CAbcBC75Cb4F789232C4DAD3793f2A8AA5
